# Local development only. Set your own password before initialization.
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-this-local-password
# Study calendar; timestamps and control records use UTC.
STUDY_TIMEZONE=America/Bogota
# Optional persistent keys; leaving them unset uses shared local defaults.
# AIRFLOW_FERNET_KEY=
# AIRFLOW_JWT_SECRET=
