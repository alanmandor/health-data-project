# Local development only. Set your own password before initialization.
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-this-local-password
# Study calendar; timestamps and control records use UTC.
STUDY_TIMEZONE=America/Bogota
# Explicit project configuration for the supplied study; end date is exclusive.
STUDY_CODE=pmdata_2026_01
STUDY_START=2026-01-08
STUDY_END_EXCLUSIVE=2026-02-05
# Bound Vault query working memory in the shared Docker VM; intermediates spill to disk.
VAULT_MEMORY_LIMIT=4GB
# Optional persistent keys; leaving them unset uses shared local defaults.
# AIRFLOW_FERNET_KEY=
# AIRFLOW_JWT_SECRET=
